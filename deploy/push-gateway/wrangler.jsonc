{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "station-push-gateway",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // Served only on the Kontour domain; the workers.dev address stays off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "push.kontourai.io", "custom_domain": true }],
  "vars": {
    // Every origin the gateway is reachable at. A Station token names one.
    "AUDIENCES": "https://push.kontourai.io",
    "ALLOWED_PACKAGES": "io.kontourai.station,io.kontourai.station.nightly,io.kontourai.station.beta,io.kontourai.station.debug",
    // iOS bundles for Live Activities. APNs delivery also needs the
    // APNS_AUTH_KEY secret; until it is set the /v1/apns routes answer 503.
    "ALLOWED_IOS_BUNDLES": "io.kontourai.station,io.kontourai.station.beta,io.kontourai.station.nightly,io.kontourai.station.dev.instance",
    "APNS_TEAM_ID": "U7KHF2QAC4",
    "APNS_KEY_ID": "AY2F92348K"
  },
  // Per-location and eventually consistent: cost ceilings, not accounting.
  // Order in the handler: per address (unsigned), then global, per key and
  // per push token (signed only). Channel create/delete adds its own global
  // and per-key ceilings: each channel spends Apple's per-app channel quota.
  "ratelimits": [
    {
      "name": "PER_IP_LIMITER",
      "namespace_id": "4103",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "GLOBAL_LIMITER",
      "namespace_id": "4102",
      "simple": { "limit": 3000, "period": 60 }
    },
    {
      "name": "PER_KEY_LIMITER",
      "namespace_id": "4101",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "PER_TOKEN_LIMITER",
      "namespace_id": "4104",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "CHANNEL_GLOBAL_LIMITER",
      "namespace_id": "4105",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "CHANNEL_PER_KEY_LIMITER",
      "namespace_id": "4106",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  // Error lines only: invocation logs would record request headers, which
  // include the Station's signed authorization.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
