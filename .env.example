# Frontend Configuration
# Override the backend API base URL (defaults to http://localhost:3141)
# VITE_API_BASE=http://localhost:3142

# Backend Configuration  
# Override the server port (defaults to 3141)
# PORT=3142

# Model providers
# Local models (Ollama) and OpenAI-compatible endpoints need NO env vars —
# they are configured in the Connections UI. See docs/guides/connections.md.
#
# Bedrock (optional): only needed if you connect AWS Bedrock as a model provider.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# OpenTelemetry (optional — traces + metrics export)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=station