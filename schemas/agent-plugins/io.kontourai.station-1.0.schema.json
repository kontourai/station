{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontour.ai/schemas/agent-plugins/io.kontourai.station/1.0/schema.json",
  "title": "Station Agent Plugin Extension 1.0",
  "description": "The value of plugin.json extensions[\"io.kontourai.station\"]. Portable Agent Plugins fields remain at the manifest root.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 128 },
    "permissions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "settings": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/setting" }
    },
    "secretReferences": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/secretReference" }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "sdkVersion": { "$ref": "#/$defs/nonEmptyString" },
    "entrypoint": { "$ref": "#/$defs/pluginRelativePath" },
    "serverModule": { "$ref": "#/$defs/pluginRelativePath" },
    "build": { "$ref": "#/$defs/nonEmptyString" },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "links": {},
    "agents": { "type": "array", "items": { "type": "object" } },
    "workspacePanes": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "object" }
    },
    "operationalEventSubscriptions": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "object" }
    },
    "providers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["type", "module"],
        "properties": {
          "type": { "$ref": "#/$defs/id" },
          "module": { "$ref": "#/$defs/pluginRelativePath" },
          "layout": false
        },
        "additionalProperties": true
      }
    },
    "integrations": { "type": "object" },
    "tools": { "type": "object" },
    "knowledge": { "type": "object" },
    "prompts": { "type": "object" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._:-]*[a-z0-9])?$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "pluginRelativePath": {
      "type": "string",
      "pattern": "^\\./"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "version": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "settingBase": {
      "type": "object",
      "required": ["key", "title", "type"],
      "properties": {
        "key": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "enum": ["string", "number", "boolean", "select"] },
        "description": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "setting": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/settingBase" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": true,
                "title": true,
                "type": { "enum": ["string", "number", "boolean"] },
                "description": true,
                "default": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "number" },
                    { "type": "boolean" }
                  ]
                },
                "required": true
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/settingBase" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["options"],
              "properties": {
                "key": true,
                "title": true,
                "type": { "const": "select" },
                "description": true,
                "default": { "type": "string" },
                "required": true,
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["title", "value"],
                    "properties": {
                      "title": { "type": "string", "minLength": 1 },
                      "value": { "type": "string" }
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title"],
      "properties": {
        "key": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string" },
        "required": { "type": "boolean" }
      }
    }
  }
}
