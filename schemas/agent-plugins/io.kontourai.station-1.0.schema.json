{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontour.ai/schemas/agent-plugins/io.kontourai.station/1.0/schema.json",
  "title": "Station Agent Plugin Extension 1.0",
  "description": "The value of plugin.json extensions[\"io.kontourai.station\"]. Portable Agent Plugins fields remain at the manifest root.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 128 },
    "permissions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "settings": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/setting" }
    },
    "secretReferences": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/secretReference" }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "sdkVersion": { "$ref": "#/$defs/nonEmptyString" },
    "entrypoint": { "$ref": "#/$defs/pluginRelativePath" },
    "serverModule": { "$ref": "#/$defs/pluginRelativePath" },
    "build": { "$ref": "#/$defs/nonEmptyString" },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "commands": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/command" }
    },
    "links": {},
    "agents": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "source"],
        "properties": {
          "slug": { "$ref": "#/$defs/id" },
          "source": { "$ref": "#/$defs/pluginRelativePath" }
        }
      }
    },
    "workspacePanes": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "object" }
    },
    "operationalEventSubscriptions": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "object" }
    },
    "providers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["type", "module"],
        "additionalProperties": false,
        "properties": {
          "type": { "$ref": "#/$defs/hostKey" },
          "module": { "$ref": "#/$defs/pluginRelativePath" },
          "layout": false
        }
      }
    },
    "integrations": { "type": "object" },
    "tools": { "type": "object" },
    "knowledge": { "type": "object" },
    "prompts": { "type": "object" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._:-]*[a-z0-9])?$"
    },
    "hostKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "pluginRelativePath": {
      "type": "string",
      "pattern": "^\\./"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "version": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "settingBase": {
      "type": "object",
      "required": ["key", "title", "type"],
      "properties": {
        "key": { "$ref": "#/$defs/hostKey" },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "enum": ["string", "number", "boolean", "select"] },
        "description": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "setting": {
      "oneOf": [
        { "$ref": "#/$defs/stringSetting" },
        { "$ref": "#/$defs/numberSetting" },
        { "$ref": "#/$defs/booleanSetting" },
        {
          "allOf": [
            { "$ref": "#/$defs/settingBase" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["options"],
              "properties": {
                "key": true,
                "title": true,
                "type": { "const": "select" },
                "description": true,
                "default": { "type": "string" },
                "required": true,
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["title", "value"],
                    "properties": {
                      "title": { "type": "string", "minLength": 1 },
                      "value": { "type": "string" }
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "stringSetting": {
      "allOf": [
        { "$ref": "#/$defs/settingBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": true,
            "title": true,
            "type": { "const": "string" },
            "description": true,
            "default": { "type": "string" },
            "required": true
          }
        }
      ]
    },
    "numberSetting": {
      "allOf": [
        { "$ref": "#/$defs/settingBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": true,
            "title": true,
            "type": { "const": "number" },
            "description": true,
            "default": { "type": "number" },
            "required": true
          }
        }
      ]
    },
    "booleanSetting": {
      "allOf": [
        { "$ref": "#/$defs/settingBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": true,
            "title": true,
            "type": { "const": "boolean" },
            "description": true,
            "default": { "type": "boolean" },
            "required": true
          }
        }
      ]
    },
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title"],
      "properties": {
        "key": { "$ref": "#/$defs/hostKey" },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "title", "intent"],
      "properties": {
        "version": { "const": "1.0" },
        "id": { "type": "string", "minLength": 3, "maxLength": 127 },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "subtitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "icon": {
          "enum": ["agent", "chat", "command", "plugin", "project", "search"]
        },
        "keywords": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 32 }
        },
        "requires": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "active-chat",
              "plugin-server",
              "project",
              "session",
              "task"
            ]
          }
        },
        "argument": { "$ref": "#/$defs/commandArgument" },
        "intent": { "$ref": "#/$defs/commandIntent" }
      }
    },
    "commandArgument": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label"],
          "properties": {
            "kind": {
              "enum": ["text", "project", "task", "session", "file", "registry-item"]
            },
            "label": { "type": "string", "minLength": 1, "maxLength": 64 },
            "required": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label", "allowedHosts"],
          "properties": {
            "kind": { "const": "url" },
            "label": { "type": "string", "minLength": 1, "maxLength": 64 },
            "required": { "type": "boolean" },
            "allowedHosts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 253 }
            }
          }
        }
      ]
    },
    "commandIntent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "surfaceId"],
          "properties": {
            "kind": { "const": "navigate" },
            "surfaceId": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "seed-composer" },
            "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "argumentMode": { "enum": ["append", "replace"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operationId"],
          "properties": {
            "kind": { "const": "invoke-declared-plugin-operation" },
            "operationId": { "$ref": "#/$defs/id" },
            "argumentMode": { "const": "body" }
          }
        }
      ]
    }
  }
}
