{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://station.kontour.ai/schemas/staged-fleet-inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "sourceSha", "workflowRunId", "cohort", "plan", "requiredVariants", "requiredArtifacts", "receipts", "inventoryContentDigest"],
  "oneOf": [{ "$ref": "#/$defs/composed" }, { "$ref": "#/$defs/admitted" }],
  "properties": {
    "kind": { "const": "station.staged-fleet-inventory/v1" }, "sourceSha": { "$ref": "#/$defs/sha" }, "workflowRunId": { "$ref": "#/$defs/run" }, "cohort": { "$ref": "#/$defs/cohort" }, "plan": { "$ref": "#/$defs/plan" }, "requiredVariants": { "$ref": "#/$defs/names" }, "requiredArtifacts": { "$ref": "#/$defs/names" }, "receipts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/receipt" } }, "attestationVerification": { "$ref": "#/$defs/verification" }, "aggregate": { "$ref": "#/$defs/aggregate" }, "inventoryContentDigest": { "$ref": "#/$defs/digest" }, "admissionContentDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "composed": { "type": "object", "not": { "anyOf": [{ "type": "object", "properties": { "attestationVerification": true }, "required": ["attestationVerification"] }, { "type": "object", "properties": { "aggregate": true }, "required": ["aggregate"] }, { "type": "object", "properties": { "admissionContentDigest": true }, "required": ["admissionContentDigest"] }] } }, "admitted": { "type": "object", "properties": { "attestationVerification": true, "aggregate": true, "admissionContentDigest": true }, "required": ["attestationVerification", "aggregate", "admissionContentDigest"] }, "stageState": { "const": "STAGED" }, "publicationState": { "const": "NOT_PUBLISHED" }, "installState": { "const": "NOT_INSTALLED" }, "updateState": { "const": "NOT_UPDATED" }, "unsupported": { "const": "UNSUPPORTED" }, "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "run": { "type": "string", "pattern": "^[1-9][0-9]*$" }, "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }, "names": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/name" } },
    "claim": { "type": "object", "additionalProperties": false, "required": ["name", "sha256", "size"], "properties": { "name": { "$ref": "#/$defs/name" }, "sha256": { "$ref": "#/$defs/digest" }, "size": { "type": "integer", "minimum": 1 } } },
    "cohort": { "type": "object", "additionalProperties": false, "required": ["cohortId", "sourceSha", "planDigest"], "properties": { "cohortId": { "type": "string", "minLength": 1 }, "sourceSha": { "$ref": "#/$defs/sha" }, "planDigest": { "$ref": "#/$defs/digest" } } }, "plan": { "type": "object", "additionalProperties": false, "required": ["kind", "contentDigest"], "properties": { "kind": { "const": "station.nightly-fleet-staging-plan/v1" }, "contentDigest": { "$ref": "#/$defs/digest" } } },
    "check": { "type": "object", "additionalProperties": false, "required": ["id", "result", "evidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "result": { "const": "PASSED" }, "evidence": { "$ref": "#/$defs/claim" } } }, "sbom": { "type": "object", "additionalProperties": false, "required": ["state", "artifact"], "properties": { "state": { "const": "GENERATED" }, "artifact": { "$ref": "#/$defs/claim" } } }, "subject": { "type": "object", "additionalProperties": false, "required": ["name", "sha256"], "properties": { "name": { "$ref": "#/$defs/name" }, "sha256": { "$ref": "#/$defs/digest" } } }, "attestation": { "type": "object", "additionalProperties": false, "required": ["subjects", "claim"], "properties": { "subjects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/subject" } }, "claim": { "const": "REQUIRED" } } },
    "receipt": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "sourceSha", "workflowRunId", "cohortId", "cohortPlanDigest", "platform", "variant", "stageState", "publicationState", "installState", "updateState", "platformSigningState", "updaterSigningState", "artifacts", "checks", "sbom", "attestation", "receiptContentDigest"], "properties": { "kind": { "const": "station.staged-fleet-stage-receipt/v1" }, "id": { "const": "portable-server" }, "sourceSha": { "$ref": "#/$defs/sha" }, "workflowRunId": { "$ref": "#/$defs/run" }, "cohortId": { "type": "string", "minLength": 1 }, "cohortPlanDigest": { "$ref": "#/$defs/digest" }, "platform": { "const": "web-portable" }, "variant": { "const": "portable-server" }, "stageState": { "$ref": "#/$defs/stageState" }, "publicationState": { "$ref": "#/$defs/publicationState" }, "installState": { "$ref": "#/$defs/installState" }, "updateState": { "$ref": "#/$defs/updateState" }, "platformSigningState": { "$ref": "#/$defs/unsupported" }, "updaterSigningState": { "$ref": "#/$defs/unsupported" }, "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } }, "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } }, "sbom": { "$ref": "#/$defs/sbom" }, "attestation": { "$ref": "#/$defs/attestation" }, "receiptContentDigest": { "$ref": "#/$defs/digest" } } },
    "proof": { "type": "object", "additionalProperties": false, "required": ["repository", "signerWorkflow", "sourceRef", "sourceSha", "oidcIssuer", "certificateIssuer", "authenticatedWorkflowRunId", "runInvocationURI", "subjectDigest", "verifiedTimestamps"], "properties": { "repository": { "const": "kontourai/station" }, "signerWorkflow": { "const": ".github/workflows/nightly-fleet-staging.yml" }, "sourceRef": { "const": "refs/heads/main" }, "sourceSha": { "$ref": "#/$defs/sha" }, "oidcIssuer": { "const": "https://token.actions.githubusercontent.com" }, "certificateIssuer": { "type": "string", "minLength": 1 }, "authenticatedWorkflowRunId": { "$ref": "#/$defs/run" }, "runInvocationURI": { "type": "string", "minLength": 1 }, "subjectDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "verifiedTimestamps": { "type": "array", "minItems": 1 } } }, "proofSubject": { "type": "object", "additionalProperties": false, "required": ["name", "sha256", "proof"], "properties": { "name": { "$ref": "#/$defs/name" }, "sha256": { "$ref": "#/$defs/digest" }, "proof": { "$ref": "#/$defs/proof" } } }, "verification": { "type": "object", "additionalProperties": false, "required": ["kind", "sourceSha", "workflowRunId", "subjects"], "properties": { "kind": { "const": "station.staged-fleet-attestation-verification/v1" }, "sourceSha": { "$ref": "#/$defs/sha" }, "workflowRunId": { "$ref": "#/$defs/run" }, "subjects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/proofSubject" } } } }, "aggregate": { "type": "object", "additionalProperties": false, "required": ["state", "complete", "publicationState", "installState", "updateState", "note"], "properties": { "state": { "const": "STAGED_COMPLETE" }, "complete": { "const": true }, "publicationState": { "const": "NOT_PUBLISHED" }, "installState": { "const": "NOT_INSTALLED" }, "updateState": { "const": "NOT_UPDATED" }, "note": { "type": "string", "minLength": 1 } } }
  }
}
