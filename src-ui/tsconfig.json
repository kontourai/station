{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases (mirrors vite.config.ts resolve.alias) */
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../src-shared/*"],
      "@kontourai/station-sdk/task-outputs": [
        "../packages/sdk/src/task-outputs.ts"
      ],
      "@kontourai/station-sdk/session-outputs": [
        "../packages/sdk/src/session-outputs.ts"
      ],
      "@kontourai/station-sdk/session-inventory": [
        "../packages/sdk/src/session-inventory.ts"
      ],
      "@kontourai/station-sdk/session-output-actions": [
        "../packages/sdk/src/session-output-actions.ts"
      ],
      "@kontourai/station-sdk/task-user-input-references": [
        "../packages/sdk/src/task-user-input-references.ts"
      ]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
