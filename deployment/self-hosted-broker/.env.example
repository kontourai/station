# Copy to .env with mode 0600. Keep .env out of source control.
PUBLIC_BIND_ADDRESS=127.0.0.1
BROKER_HOST=broker.example.org
TLS_CERT_DIR=/absolute/private/tls
BROKER_HTTPS_PORT=8443
TURN_PORT=13478
TURN_TLS_PORT=15349
TURN_REALM=broker.example.org
TURN_USERNAME=replace-with-a-long-random-username
TURN_PASSWORD=replace-with-a-long-random-password
TURN_EXTERNAL_IP=127.0.0.1

# Build identity. Set these in the shell before `docker compose build`.
STATION_RELEASE_SHA=
STATION_RELEASE_REF=
STATION_RELEASE_CREATED_AT=
