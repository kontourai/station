      "title": "Agent Operation Observations",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "station-prometheus"
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (op) (station_agent_operations_total{op!=\"\"})",
          "legendFormat": "Route: {{op}}"
        },
        {
          "expr": "sum by (operation) (station_agent_operations_total{operation!=\"\"})",
          "legendFormat": "Service: {{operation}}"
        }
      ],
      "description": "Route and service observations are shown separately. Their sum is not a count of distinct operations."
    },
    {
      "id": 24,
      "type": "bargauge",
      "title": "Project Operation Observations",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
