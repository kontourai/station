{
  "uid": "station-overview",
  "title": "Station Overview",
  "schemaVersion": 38,
  "version": 4,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Primary Chat Requests",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "station-prometheus"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "targets": [
        {
          "expr": "sum(station_chat_requests_total{agent!=\"\"})",
          "legendFormat": "Primary chat"
        }
      ],
      "description": "Primary chat finalizations, including failed or canceled requests. Independent invocation route traffic is excluded."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Loaded Agents",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "station-prometheus"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "targets": [
        {
          "expr": "station_agents_active",
          "legendFormat": "Active"
        }
      ],
      "description": "Agent objects held in Station’s loaded map. This does not measure concurrent work."
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Tracked MCP Server Entries",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "station-prometheus"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        }
      },
      "targets": [
        {
          "expr": "station_mcp_connections",
          "legendFormat": "Tracked entries"
        }
      ],
      "description": "MCP status map cardinality, including failed entries."
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Chat Route Errors",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "station-prometheus"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      },
      "targets": [
        {
          "expr": "sum(station_chat_errors_total)",
          "legendFormat": "Total"
        }
      ],
      "description": "Outer chat-route errors. Stream failures after an SSE response has opened are a separate population."
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Estimated Primary Chat Cost",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "station-prometheus"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          },
          "decimals": 4
        }
      },
      "targets": [
        {
          "expr": "sum(station_cost_estimated_total)",
          "legendFormat": "Total"
        }
      ],
      "description": "Partial positive Bedrock estimates from primary chat, in USD. Provider billing and other engines are outside this estimate."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Primary Chat p95",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "station-prometheus"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(station_chat_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "description": "Global five-minute quantile across all Agent and plugin histogram buckets."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Primary Chat Request Rate",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "station-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (agent) (rate(station_chat_requests_total{agent!=\"\"}[5m]))",
          "legendFormat": "{{agent}}"
        }
      ],
      "description": "Per-Agent primary chat finalizations per second."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Reported Primary Chat Token Rate",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "station-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(station_tokens_input_total[5m]))",
          "legendFormat": "Input"
        },
        {
          "expr": "sum(rate(station_tokens_output_total[5m]))",
          "legendFormat": "Output"
        }
      ],
      "description": "Reported primary chat token usage per second. Missing usage contributes no point."
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Primary Chat Requests by Agent",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "station-prometheus"
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (agent) (station_chat_requests_total{agent!=\"\"})",
          "legendFormat": "{{agent}}"
        }
      ],
      "description": "Primary chat finalizations grouped by Agent."
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Metadata Tool-call Chunks",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "station-prometheus"
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (tool) (station_tool_calls_total)",
          "legendFormat": "{{tool}}"
        }
      ],
      "description": "Tool-call chunks seen by MetadataHandler. External-engine bridge calls are outside this count."
    },
    {
      "id": 20,
      "type": "row",
      "title": "CRUD Operations",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
