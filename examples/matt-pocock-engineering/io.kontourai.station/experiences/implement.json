  "requiredContext": [
    {
      "kind": "project",
      "required": true,
      "provenance": {
        "origin": "station-added",
        "explanation": "This visual implementation stage requires an explicitly selected Project. Agent tools and project write authority still apply."
      }
    },
    {
      "kind": "conversation",
