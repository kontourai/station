  "capabilities": [
    "conversation",
    "artifact-output",
    "project-read",
    "file-read"
  ],
  "inputs": [
    {
      "id": "tickets",
      "kind": "text",
      "label": "Reviewed specification or tickets to implement",
      "description": "Name the exact work and pre-agreed testing seams. Selecting this stage does not start implementation until you send.",
      "required": true,
      "minLength": 1,
      "maxLength": 16000,
      "provenance": {
        "origin": "skill-declared",
        "skillRef": "implement",
        "explanation": "Upstream implements the specification or tickets described by the user, using pre-agreed testing seams."
      }
    }
  ],
  "interaction": {
    "pattern": "transform",
    "stopConditions": [
      "Only implement the work the user explicitly selected.",
      "Use TDD where possible at pre-agreed seams; run typechecks and focused tests, then the full suite at the end.",
      "Review the work with the bundled code-review instructions before committing to the current branch.",
      "If required tools, testing seams or branch/project authority are unavailable, report the missing prerequisite instead of claiming completion."
    ],
    "unsupportedBehavior": [
      "Selecting a previous stage never authorizes implementation automatically.",
      "Worktree, branch, file writes and commits follow the selected Agent\u2019s ordinary policy and repository instructions.",
      "The interface does not infer successful tests, review or commits from model prose."
    ]
  },
  "outputs": [
    {
      "id": "implementation",
      "label": "Implementation, review and actual commit outcome",
      "kind": "markdown",
      "required": true,
      "provenance": {
        "origin": "skill-declared",
        "skillRef": "implement",
        "explanation": "The source requests implementation, checks, review and a current-branch commit. Only actual canonical tool outcomes establish those effects."
      }
    }
  ],
  "presentation": {
    "modes": ["guided", "alongside"],
    "defaultMode": "guided"
  },
  "entrySkillId": "implement",
