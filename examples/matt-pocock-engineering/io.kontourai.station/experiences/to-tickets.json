  "requiredContext": [
    {
      "kind": "conversation",
      "required": true,
      "provenance": {
        "origin": "skill-declared",
        "skillRef": "to-tickets",
        "explanation": "Use current conversation decisions and referenced reviewed outputs; later steps must not invent replacements."
      }
    },
    {
      "kind": "project",
      "required": true,
      "provenance": {
        "origin": "skill-declared",
        "skillRef": "to-tickets",
        "explanation": "Read actual project glossary/ADRs; tracker configuration is a prerequisite for spec and ticket publication."
      }
    }
  ],
  "capabilities": [
    "conversation",
    "artifact-output",
    "project-read",
    "file-read"
  ],
  "inputs": [
    {
      "id": "context",
      "kind": "text",
      "label": "Idea or reviewed context reference",
      "description": "For a later stage, continue the existing conversation and name the reviewed spec or decisions.",
      "required": false,
      "minLength": 0,
      "maxLength": 16000,
      "provenance": {
        "origin": "skill-declared",
        "skillRef": "to-tickets",
        "explanation": "The interview needs a plan; synthesis/tickets use existing conversation or an explicit reference."
      }
    }
  ],
  "interaction": {
    "pattern": "transform",
    "stopConditions": [
      "If tracker configuration is missing, request setup.",
      "Review granularity and blocking edges; iterate until breakdown approval.",
      "Publish one ticket per approved slice; do not modify or close the parent.",
      "Use the existing authority boundary for concrete writes or publication."
    ],
    "unsupportedBehavior": [
      "Literal dependency detection is conservative; inspect source and setup.",
      "Environment facts require a capable agent with subagents; do not substitute user guesses.",
      "Tools, file writes, tracker access and publication depend on the selected agent and its permissions.",
      "Guided view only renders canonical requests; prose question rounds remain answerable in chat.",
      "Automatic progression or implementation is not authorized by choosing an experience.",
      "User-invoked Skills are only entered by explicit user selection; their nonportable disable-model-invocation flag is removed in adapted frontmatter and original source is retained under upstream/. Do not auto-invoke setup or implementation."
    ]
  },
  "outputs": [
    {
      "id": "tickets",
      "label": "Approved tickets and actual references",
      "kind": "markdown",
      "required": true,
      "provenance": {
        "origin": "skill-declared",
        "skillRef": "to-tickets",
        "explanation": "The source specifies the artifact and publication; a draft alone does not establish publication."
      }
    }
  ],
  "presentation": {
    "modes": ["guided", "alongside"],
    "defaultMode": "guided"
  },
  "entrySkillId": "to-tickets",
  "transitions": [
    {
      "experienceId": "implement",
      "label": "Choose tickets to implement",
      "provenance": {
        "origin": "station-added",
        "explanation": "Station offers this optional next stage after the user reviews current work. Selecting it prepares a draft; sending and concrete tool actions remain explicit user decisions."
      }
    }
  ]
}
