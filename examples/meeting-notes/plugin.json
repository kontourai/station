{
  "name": "meeting-notes",
  "version": "1.0.0",
  "displayName": "Meeting Notes",
  "description": "Capture a meeting transcript, compile it into a note with a provenance link back to the raw transcript, and recall it via a wikilink graph and retrieval-grounded Q&A (Knowledge K5).",
  "entrypoint": "src/index.tsx",
  "capabilities": ["navigation", "knowledge"],
  "permissions": ["navigation.dock"],
  "agents": [
    {
      "slug": "compile",
      "source": "./agents/compile/agent.json"
    }
  ],
  "workspacePanes": [
    {
      "version": "1.0",
      "id": "pane:plugin%3Ameeting-notes:meeting-notes:capture",
      "name": "Capture",
      "rendererId": "renderer:plugin%3Ameeting-notes:plugin-component:meeting-notes-capture",
      "renderer": {
        "kind": "plugin-component",
        "name": "meeting-notes-capture"
      },
      "placement": {
        "supportedRegions": ["primary"],
        "preferredRegion": "primary"
      },
      "modes": [{ "id": "default", "contextRequirement": { "project": true } }],
      "provenance": { "origin": "plugin", "pluginId": "meeting-notes" },
      "lifecycle": { "stage": "stable" }
    },
    {
      "version": "1.0",
      "id": "pane:plugin%3Ameeting-notes:meeting-notes:library",
      "name": "Library",
      "rendererId": "renderer:plugin%3Ameeting-notes:plugin-component:meeting-notes-library",
      "renderer": {
        "kind": "plugin-component",
        "name": "meeting-notes-library"
      },
      "placement": {
        "supportedRegions": ["primary"],
        "preferredRegion": "primary"
      },
      "modes": [{ "id": "default", "contextRequirement": { "project": true } }],
      "provenance": { "origin": "plugin", "pluginId": "meeting-notes" },
      "lifecycle": { "stage": "stable" }
    },
    {
      "version": "1.0",
      "id": "pane:plugin%3Ameeting-notes:meeting-notes:ask",
      "name": "Ask",
      "rendererId": "renderer:plugin%3Ameeting-notes:plugin-component:meeting-notes-ask",
      "renderer": {
        "kind": "plugin-component",
        "name": "meeting-notes-ask"
      },
      "placement": {
        "supportedRegions": ["primary"],
        "preferredRegion": "primary"
      },
      "modes": [{ "id": "default", "contextRequirement": { "project": true } }],
      "provenance": { "origin": "plugin", "pluginId": "meeting-notes" },
