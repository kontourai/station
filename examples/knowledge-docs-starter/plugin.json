{
  "name": "knowledge-docs-starter",
  "version": "1.0.0",
  "displayName": "Knowledge Docs Starter",
  "description": "Knowledge and documentation starter layout for document intake, source review, and question answering.",
  "entrypoint": "src/index.tsx",
  "capabilities": ["chat", "navigation", "knowledge"],
  "permissions": ["navigation.dock"],
  "workspacePanes": [
    {
      "version": "1.0",
      "id": "pane:plugin%3Aknowledge-docs-starter:knowledge-docs:library",
      "name": "Library",
      "rendererId": "renderer:plugin%3Aknowledge-docs-starter:plugin-component:knowledge-library",
      "renderer": { "kind": "plugin-component", "name": "knowledge-library" },
      "placement": {
        "supportedRegions": ["primary"],
        "preferredRegion": "primary"
      },
      "modes": [{ "id": "default", "contextRequirement": { "project": true } }],
      "actions": [
        {
          "type": "prompt",
          "label": "Summarize selected documents",
          "data": "Summarize the selected documents and cite the source names that support each claim."
        }
      ],
      "provenance": {
        "origin": "plugin",
        "pluginId": "knowledge-docs-starter"
      },
      "lifecycle": { "stage": "stable" }
    },
    {
      "version": "1.0",
      "id": "pane:plugin%3Aknowledge-docs-starter:knowledge-docs:ask",
      "name": "Ask",
      "rendererId": "renderer:plugin%3Aknowledge-docs-starter:plugin-component:knowledge-ask",
      "renderer": { "kind": "plugin-component", "name": "knowledge-ask" },
      "placement": {
        "supportedRegions": ["primary"],
        "preferredRegion": "primary"
      },
      "modes": [{ "id": "default", "contextRequirement": { "project": true } }],
      "provenance": {
        "origin": "plugin",
        "pluginId": "knowledge-docs-starter"
      },
      "lifecycle": { "stage": "stable" }
    },
    {
      "version": "1.0",
      "id": "pane:plugin%3Aknowledge-docs-starter:knowledge-docs:sources",
      "name": "Sources",
      "rendererId": "renderer:plugin%3Aknowledge-docs-starter:plugin-component:knowledge-sources",
      "renderer": { "kind": "plugin-component", "name": "knowledge-sources" },
      "placement": {
        "supportedRegions": ["primary"],
        "preferredRegion": "primary"
      },
      "modes": [{ "id": "default", "contextRequirement": { "project": true } }],
      "provenance": {
        "origin": "plugin",
        "pluginId": "knowledge-docs-starter"
      },
      "lifecycle": { "stage": "stable" }
    }
  ],
  "knowledge": {
    "namespaces": [
      {
        "id": "starter-docs",
        "label": "Starter Documents",
        "behavior": "rag",
        "description": "Documents uploaded or synced for this starter workspace."
      }
    ]
  }
}
