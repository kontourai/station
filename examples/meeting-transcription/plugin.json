{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "meeting-transcription",
  "version": "0.1.0",
  "description": "Continuous speech capture → transcript → extract action items, from a Workspace Pane.",
  "extensions": {
    "io.kontourai.station": {
      "schemaVersion": "1.0",
      "title": "Meeting Transcription",
      "entrypoint": "./src/index.ts",
      "capabilities": ["chat"],
      "permissions": ["agents.invoke"],
      "workspacePanes": [
        {
          "version": "1.0",
          "id": "pane:plugin%3Ameeting-transcription:meeting:workspace",
          "name": "Meeting Transcription",
          "rendererId": "renderer:plugin%3Ameeting-transcription:plugin-component:meeting-transcription",
          "renderer": {
            "kind": "plugin-component",
            "name": "meeting-transcription"
          },
          "placement": {
            "supportedRegions": ["primary"],
            "preferredRegion": "primary"
          },
          "modes": [
            {
              "id": "default",
              "contextRequirement": {
                "project": true
              }
            }
          ],
          "provenance": {
            "origin": "plugin",
            "pluginId": "meeting-transcription"
          },
          "lifecycle": {
            "stage": "preview"
          }
        }
      ]
    }
  }
}
