{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "minimal-layout",
  "version": "1.0.0",
  "description": "A minimal Workspace Pane for Agent discovery and explicit chat dock navigation.",
  "extensions": {
    "io.kontourai.station": {
      "schemaVersion": "1.0",
      "title": "Minimal Workspace",
      "entrypoint": "./src/index.tsx",
      "capabilities": ["chat", "navigation"],
      "permissions": ["navigation.dock"],
      "workspacePanes": [
        {
          "version": "1.0",
          "id": "pane:plugin%3Aminimal-layout:minimal:workspace",
          "name": "Minimal Workspace",
          "rendererId": "renderer:plugin%3Aminimal-layout:plugin-component:minimal-workspace",
          "renderer": {
            "kind": "plugin-component",
            "name": "minimal-workspace"
          },
          "placement": {
            "supportedRegions": ["primary"],
            "preferredRegion": "primary"
          },
          "modes": [
            {
              "id": "default",
              "contextRequirement": {
                "project": true
              }
            }
          ],
          "provenance": {
            "origin": "plugin",
            "pluginId": "minimal-layout"
          },
          "lifecycle": {
            "stage": "stable"
          }
        }
      ]
    }
  }
}
