{
  "name": "enterprise-layout",
  "version": "1.0.0",
  "displayName": "Enterprise Layout",
  "description": "Calendar, CRM, and notes layout \u2014 demonstrates multi-provider plugin architecture",
  "entrypoint": "src/index.tsx",
  "capabilities": ["chat", "navigation", "agents"],
  "permissions": ["navigation.dock", "agents.invoke"],
  "env": {
    "NOTES_VAULT_PATH": {
      "required": true,
      "description": "Path to your notes vault",
      "sensitive": false,
      "promptAt": "install"
    }
  },
  "integrations": [
    "./integrations/crm/integration.json",
    "./integrations/calendar/integration.json"
  ],
  "agents": [
    {
      "slug": "enterprise-assistant",
      "source": "./agents/enterprise-assistant/agent.json"
    }
  ],
  "layout": {
    "slug": "enterprise",
    "source": "./layout.json"
  },
  "prompts": {
    "source": "./prompts"
  },
  "knowledge": {
    "namespaces": [
      {
        "id": "notes",
        "label": "Meeting Notes",
        "behavior": "rag"
      }
    ]
  },
  "dependencies": [
    {
      "id": "shared-providers",
      "source": "../shared-providers"
    }
  ],
  "workspacePaneHost": {
    "version": "station.workspace-pane-host-contribution/v1",
    "actions": [
      {
        "id": "daily",
        "label": "Daily Overview",
        "presentation": "action",
        "intent": {
          "kind": "plugin-prompt",
          "promptId": "daily"
        }
      }
    ],
    "agentSelection": {
      "availableAgents": [
        {
          "kind": "own-plugin-agent",
          "agentId": "enterprise-assistant"
        }
      ],
      "defaultAgent": {
        "kind": "own-plugin-agent",
        "agentId": "enterprise-assistant"
      }
    }
  }
}
