# The container build context is an allowlist. Keep credentials, repository
# metadata, local Station state, test output, and newly-added paths out unless
# the Dockerfile explicitly needs them.
*

!package.json
!package-lock.json
!.npmrc
!station
!esbuild.config.mjs
!vite.config.ts
!tsconfig.json
!tsconfig.tests.json

# vite.config.ts imports src-desktop/tauri.conf.json at config-load time, so
# the container build needs only that single file in its allowlisted context.
!src-desktop/
src-desktop/*
!src-desktop/tauri.conf.json

# The repository is public: scripts/ and config/ are shipped wholesale
# (tests excluded) instead of a per-file allowlist. The allowlist's curation
# rationale predates the public flip, and its maintenance cost was five
# consecutive container-build failures as the CLI's import closure grew
# past it one file at a time (2026-08-27 shakedown).
!scripts/
scripts/__tests__/
scripts/dogfood/

!config/
!patches/
!patches/**

!packages/
!packages/**
!src-server/
!src-server/**
!src-shared/
!src-shared/**
!src-ui/
!src-ui/**
!schemas/
!schemas/**
!seed/
!seed/**

# Bundled starter registry and the plugin sources it resolves. The image needs
# these because examples/registry/default.json is the manifest Station falls
# back to when no registryUrl is configured.
!examples/
!examples/**

# Build/runtime source never needs repository tests, fixtures, or key material.
**/__tests__
**/__tests__/**
**/fixtures
**/fixtures/**
**/*.test.*
**/*.spec.*
**/*.pem
**/*.key
