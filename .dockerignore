# The container build context is an allowlist. Keep credentials, repository
# metadata, local Station state, test output, and newly-added paths out unless
# the Dockerfile explicitly needs them.
*

!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!station
!esbuild.config.mjs
!vite.config.ts
!tsconfig.json
!tsconfig.tests.json

# vite.config.ts imports src-desktop/tauri.conf.json at config-load time, so
# the container build needs only that single file in its allowlisted context.
!src-desktop/
src-desktop/*
!src-desktop/tauri.conf.json

# The repository is public: scripts/ and config/ are shipped wholesale
# (tests excluded) instead of a per-file allowlist. The allowlist's curation
# rationale predates the public flip, and its maintenance cost was five
# consecutive container-build failures as the CLI's import closure grew
# past it one file at a time (2026-08-27 shakedown).
!scripts/
scripts/__tests__/
scripts/dogfood/

# Station's shipped docs are build inputs, not documentation: the server build
# reads STATION_DOCS_INPUT_PATHS out of docs/ (see scripts/generate-station-docs.mjs).
# Excluded from the build context until #2886 wired that generation into
# esbuild.config.mjs without adding docs/ here, which broke every container
# build that actually ran with ENOENT docs/reference/station-docs.md. The build
# stage is discarded, so this costs context size and not image size.
!docs/
!docs/**
# That generation formats through Biome and byte-compares the committed output,
# so it needs the repository's formatter config (and .gitignore, which
# biome.json's vcs.useIgnoreFile requires) or the build fails "stale".
!biome.json
!.gitignore

!config/
!patches/
!patches/**

# The node-pty prebuild channel (#1245): the dependencies stage COPYs this
# directory so the lifecycle's consistency check can read its manifest. The
# rest of packaging/ (installer and tap material) never enters the image.
!packaging/
packaging/*
!packaging/node-pty-prebuilds/
!packaging/node-pty-prebuilds/**

!packages/
!packages/**
!src-server/
!src-server/**
!src-shared/
!src-shared/**
!src-ui/
!src-ui/**
!schemas/
!schemas/**
!seed/
!seed/**

# Bundled starter registry and the plugin sources it resolves. The image needs
# these because examples/registry/default.json is the manifest Station falls
# back to when no registryUrl is configured.
!examples/
!examples/**

# Build/runtime source never needs repository tests, fixtures, or key material.
# Keep host dependencies/builds from overlaying the Linux dependency stage.
**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/__tests__
**/__tests__/**
**/fixtures
**/fixtures/**
**/*.test.*
**/*.spec.*
**/*.pem
**/*.key
