node_modules/
dist/
dist-pages/
dist-ui/
dist-ui-*/
dist-server/
dist-server-*/
dist-desktop/
dist-desktop-wix-resources/
coverage/

# Runtime data (generated by plugin install and app usage)
.station/

.amazonq/
.kiro/
*.log
.DS_Store
.env
.env.local
event_persistence

# Tauri
src-desktop/target/
src-desktop/binaries/
# Tauri rewrites these platform-derived capability schemas during builds.
# They are editor/build output, not portable source inputs.
src-desktop/gen/schemas/

# Plugins and workspaces (installed via CLI, except core files)
src-ui/src/workspaces/*/
src-ui/src/plugins/
!src-ui/src/workspaces/.gitkeep
!src-ui/src/workspaces/index.tsx
!src-ui/src/plugins/.gitkeep
!src-ui/src/plugins/shared/
.bedrock-debug-*.json

# Audit cleanup
archive/
*.png
!src-ui/public/favicon-beta.png
!src-ui/public/favicon-nightly.png
# Platform icon sets are source-controlled build INPUT, not build output, and
# the negation below is single-level so nested sets need their own entries.
# Without them Android fails resource linking outright (mipmap-anydpi-v26/
# ic_launcher.xml references @mipmap/ic_launcher_foreground) and iOS silently
# ships an icon-less bundle (ASSETCATALOG_COMPILER_APPICON_NAME=AppIcon).
!src-desktop/icons/*.png
!src-desktop/gen/android/app/src/main/res/mipmap-*/*.png
# The debug source set carries the distinguishing dev-variant icon. The
# negation above is pinned to `main/`, so without this line the dev icons are
# silently gitignored: the variant looks right in a working tree that happens
# to hold them and builds with the release icon from a fresh clone.
!src-desktop/gen/android/app/src/debug/res/mipmap-*/*.png
!src-desktop/gen/apple/Assets.xcassets/AppIcon.appiconset/*.png
# Brand masters and the per-channel nightly set are source-controlled build
# input too (bundle.icon in tauri.nightly.conf.json and the nightly.yml
# Android copy step read them from a fresh clone).
!assets/brand/*.png
# station#4464: the screenshot comparator's reference images are committed
# baseline INPUT (screenshot-diff.mjs reads them to localize a pixel diff),
# not build output — same reasoning as the icon sets above.
!tests/screenshots.baseline/*.png
!src-desktop/icons/nightly/*.png
!src-desktop/icons/nightly/android/mipmap-*/*.png
!src-ui/public/favicon.png
# favicon-dev.png is what a dev build's is-dev-build rule actually displays.
!src-ui/public/favicon-dev.png
.station.pids
test-results/
playwright-report/
?/
*.tsbuildinfo
qa-reports/
docs/audits/
.omx/
.fallow/
.flow-agents/
.kontourai/

# Generated Veritas artifacts are covered by .kontourai/ above; commit only
# curated fixtures/examples. Durable governance config stays tracked under
# .veritas/: repo-map.json, repo-standards/**, authority/**, proof-families/**,
# attestations/**, and deliberately reviewed init-plans/**.
.surface/

# Flow run artifacts (reports for dogfood entries are copied to docs/strategy/dogfood/)
# Deliberately wholesale-ignored: a live run's state.json/definition.json carry raw
# command output and working-tree paths. The evidence artifacts the committed
# report.md digests actually cite are copied to docs/strategy/dogfood/<run>/evidence/
# instead, so a receipt can be resolved to bytes from a clean clone.
.flow/runs/
# Load-bearing, not decorative: `*.png` above already shadows
# docs/strategy/dogfood/dogfood-015-product-icons/*.png (force-added), and two
# retained evidence artifacts are `.txt` tails that a future `*.log`-shaped rule
# would silently orphan. scripts/__tests__/dogfood-evidence-retention.test.ts
# fails if any cited digest loses its artifact.
!docs/strategy/dogfood/*/evidence/
!docs/strategy/dogfood/*/evidence/**

# Console bridge output (S4): generated kontour.console.event streams + export
# manifests written into the project workspace when the file sink is enabled
.kontour/

# Claude Code harness worktrees (live sibling-agent checkouts; each contains
# its own .git link, so untracked-file enumeration would otherwise surface
# them as bare directory paths and trip the prepush provenance hash).
.claude/worktrees/

# vite writes these beside the config when it re-bundles it (the build-identity
# determinism test does this twice per run); they are transient, not artifacts.
vite.config.ts.timestamp-*.mjs
app-universal-debug.apk

# CI batch scratch marker; was committed by accident once (nothing reads it).
.ci-final.exit
