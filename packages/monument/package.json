{
  "name": "@kontourai/monument",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental engine-neutral durability kernel: a command-shaped storage port, pure decision functions, in-memory and node:sqlite adapters, and an exported conformance suite",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sqlite": "./src/sqlite.ts",
    "./adapter": "./src/adapter.ts",
    "./testing": "./src/testing/index.ts"
  },
  "files": [
    "src",
    "!src/__tests__",
    "!src/**/*.test.ts",
    "README.md",
    "CONTEXT.md",
    "LICENSE"
  ],
  "keywords": [
    "durability",
    "idempotency",
    "crash-consistency",
    "kontour"
  ],
  "author": "Kontour",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontourai/station.git",
    "directory": "packages/monument"
  },
  "publishConfig": {
    "access": "public"
  }
}
