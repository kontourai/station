{
  "name": "@kontourai/station-board-pane",
  "private": true,
  "version": "0.1.3",
  "description": "The Console Board as a Station Workspace Pane, on published contracts only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./workspace-board-pane": "./src/workspace-board-pane.ts"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "station",
    "board",
    "workspace-pane"
  ],
  "files": [
    "src",
    "!src/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "author": "Station",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontourai/station.git",
    "directory": "packages/board-pane"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kontourai/console-ui": "^0.2.0",
    "@kontourai/station-contracts": "^0.8.0",
    "@kontourai/station-sdk": "^0.8.0",
    "@kontourai/ui": "^1.12.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
