<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Debug builds only. Lets `adb shell am broadcast` deliver a payload to a
         process that is not running, which is how push wakes the app, before
         a Firebase project exists. DUMP is held by the shell; another app can
         only obtain it through `adb shell pm grant`, so sending this needs adb. -->
    <receiver
      android:name="io.kontourai.station.agentactivity.DebugAgentActivityReceiver"
      android:exported="true"
      android:permission="android.permission.DUMP">
      <intent-filter>
        <action android:name="io.kontourai.station.agentactivity.DEBUG_DELIVER" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
