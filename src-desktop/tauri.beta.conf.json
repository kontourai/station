{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Station Beta",
  "identifier": "io.kontourai.station.beta",
  "app": {
    "windows": [
      {
        "title": "Station Beta",
        "width": 1200,
        "height": 800,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "macOS": {
      "infoPlist": "Info.beta.plist"
    },
    "icon": [
      "icons/beta/32x32.png",
      "icons/beta/128x128.png",
      "icons/beta/128x128@2x.png",
      "icons/beta/icon.icns",
      "icons/beta/icon.ico"
    ]
  }
}
