{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Station Nightly",
  "identifier": "io.kontourai.station.nightly",
  "build": {
    "beforeBuildCommand": "npm run build:desktop:resources"
  },
  "app": {
    "windows": [
      {
        "title": "Station Nightly",
        "width": 1200,
        "height": 800,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "macOS": {
      "infoPlist": "Info.nightly.plist"
    },
    "resources": {
      "../dist-server": "dist-server",
      "../dist-desktop-runtime/node_modules": "node_modules",
      "../schemas": "schemas"
    },
    "icon": [
      "icons/nightly/32x32.png",
      "icons/nightly/128x128.png",
      "icons/nightly/128x128@2x.png",
      "icons/nightly/icon.icns",
      "icons/nightly/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["station-nightly"], "appLink": false }],
      "desktop": { "schemes": ["station-nightly"] }
    }
  }
}
