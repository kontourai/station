{
  "name": "host-action-browser-proof",
  "version": "1.0.0",
  "description": "Disposable managed-browser host-action proof using Muse echo",
  "permissions": ["agents.invoke"],
  "agents": [
    {
      "slug": "host-action-echo",
      "source": "./agents/host-action-echo/agent.json"
    }
  ],
  "workspacePaneHost": {
    "version": "station.workspace-pane-host-contribution/v1",
    "agentSelection": {
      "availableAgents": [
        { "kind": "own-plugin-agent", "agentId": "host-action-echo" }
      ],
      "defaultAgent": {
        "kind": "own-plugin-agent",
        "agentId": "host-action-echo"
      }
    },
    "actions": [
      {
        "id": "echo-proof",
        "label": "Run host action proof",
        "presentation": "action",
        "intent": { "kind": "prompt", "prompt": "HOST_ACTION_BROWSER_1372" }
      }
    ]
  }
}
