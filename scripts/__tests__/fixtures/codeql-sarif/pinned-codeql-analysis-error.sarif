{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "organization": "GitHub",
          "semanticVersion": "2.26.3",
          "rules": []
        },
        "extensions": [
          {
            "name": "codeql/javascript-queries",
            "semanticVersion": "2.4.3+44a68d3a47fcbcd6a6a76ec7d1c1b3a1a28b201e",
            "rules": [
              {
                "id": "js/request-forgery",
                "name": "js/request-forgery",
                "defaultConfiguration": {
                  "enabled": true,
                  "level": "error"
                },
                "properties": {
                  "security-severity": "9.1"
                }
              },
              {
                "id": "js/insecure-temporary-file",
                "name": "js/insecure-temporary-file",
                "defaultConfiguration": {
                  "enabled": true,
                  "level": "warning"
                },
                "properties": {
                  "security-severity": "7.0"
                }
              }
            ]
          },
          {
            "name": "codeql/javascript-all",
            "semanticVersion": "2.9.0+44a68d3a47fcbcd6a6a76ec7d1c1b3a1a28b201e",
            "rules": []
          }
        ]
      },
      "invocations": [
        {
          "executionSuccessful": false,
          "toolExecutionNotifications": [
            {
              "level": "error",
              "message": {
                "text": "Analysis interrupted before completion."
              }
            }
          ]
        }
      ],
      "columnKind": "utf16CodeUnits",
      "results": []
    }
  ]
}
